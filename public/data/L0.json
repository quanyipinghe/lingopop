    {"id": "L0-001", "topic": "hello", "emoji": "🙋", "word": "hello", "zh": "你好", "fact": "和人见面说 Hello! 熟一点的朋友之间还可以说 Hi!", "quiz": {"type": "picture", "options": ["🙋", "👋", "🌅"]}},
    {"id": "L0-002", "topic": "hello", "emoji": "👋", "word": "bye-bye", "zh": "再见", "fact": "小朋友说 bye-bye，大人常说 bye 或者 See you!（回头见）", "quiz": {"type": "picture", "options": ["👋", "🌅", "🛌"]}},
    {"id": "L0-003", "topic": "hello", "emoji": "🌅", "word": "good morning", "zh": "早上好", "fact": "早上见面说 Good morning! 到了下午就说 Good afternoon!", "quiz": {"type": "picture", "options": ["🌅", "🛌", "🎁"]}},
    {"id": "L0-004", "topic": "hello", "emoji": "🛌", "word": "good night", "zh": "晚安", "fact": "Good night 是睡觉前才说的。晚上刚见面打招呼要说 Good evening。", "quiz": {"type": "picture", "options": ["🛌", "🎁", "🙏"]}},
    {"id": "L0-005", "topic": "hello", "emoji": "🎁", "word": "thank you", "zh": "谢谢", "fact": "收到礼物说 Thank you! 别人谢谢你，你可以回答 You're welcome.", "quiz": {"type": "picture", "options": ["🎁", "🙏", "🙇"]}},
    {"id": "L0-006", "topic": "hello", "emoji": "🙏", "word": "please", "zh": "请", "fact": "想要东西时加上 please，马上变得很有礼貌：Water, please!", "quiz": {"type": "picture", "options": ["🙏", "🙇", "✅"]}},
    {"id": "L0-007", "topic": "hello", "emoji": "🙇", "word": "sorry", "zh": "对不起", "fact": "不小心碰到别人，说 Sorry! 别人原谅你会说 That's OK.", "quiz": {"type": "picture", "options": ["🙇", "✅", "❌"]}},
    {"id": "L0-008", "topic": "hello", "emoji": "✅", "word": "yes", "zh": "是的", "fact": "点点头就是 yes。英语里也可以说 Yeah 或者 OK!", "quiz": {"type": "picture", "options": ["✅", "❌", "❤️"]}},
    {"id": "L0-009", "topic": "hello", "emoji": "❌", "word": "no", "zh": "不", "fact": "摇摇头就是 no。礼貌地拒绝要说 No, thank you.", "quiz": {"type": "picture", "options": ["❌", "❤️", "🙌"]}},
    {"id": "L0-010", "topic": "hello", "emoji": "❤️", "word": "I love you", "zh": "我爱你", "fact": "睡前抱抱爸爸妈妈，说一句 I love you! 他们会说 I love you too.", "quiz": {"type": "picture", "options": ["❤️", "🙌", "🤗"]}},
    {"id": "L0-011", "topic": "hello", "emoji": "🙌", "word": "high five", "zh": "击掌", "fact": "举起手掌“啪”地拍一下。一只手有五根手指，所以叫 high five!", "quiz": {"type": "picture", "options": ["🙌", "🤗", "🙋"]}},
    {"id": "L0-012", "topic": "hello", "emoji": "🤗", "word": "hug", "zh": "抱抱", "fact": "张开双臂抱一抱就是 hug。Give me a hug! 意思是“抱抱我！”", "quiz": {"type": "picture", "options": ["🤗", "🙋", "👋"]}},
    {"id": "L0-013", "topic": "family", "emoji": "👩", "word": "mom", "zh": "妈妈", "fact": "美国人写 mom，英国人写 mum，都是妈妈。", "quiz": {"type": "picture", "options": ["👩", "👨", "👶"]}},
    {"id": "L0-014", "topic": "family", "emoji": "👨", "word": "dad", "zh": "爸爸", "fact": "dad 正着读、倒着读都是 dad！mom 也一样哦。", "quiz": {"type": "picture", "options": ["👨", "👶", "👵"]}},
    {"id": "L0-015", "topic": "family", "emoji": "👶", "word": "baby", "zh": "宝宝", "fact": "刚出生的小宝宝叫 baby，小狗宝宝有自己的名字，叫 puppy。", "quiz": {"type": "picture", "options": ["👶", "👵", "👴"]}},
    {"id": "L0-016", "topic": "family", "emoji": "👵", "word": "grandma", "zh": "奶奶/外婆", "fact": "英语里奶奶和外婆都叫 grandma，不分爸爸那边还是妈妈那边。", "quiz": {"type": "picture", "options": ["👵", "👴", "👦"]}},
    {"id": "L0-017", "topic": "family", "emoji": "👴", "word": "grandpa", "zh": "爷爷/外公", "fact": "英语里爷爷和外公都叫 grandpa，一个词就够了。", "quiz": {"type": "picture", "options": ["👴", "👦", "👧"]}},
    {"id": "L0-018", "topic": "family", "emoji": "👦", "word": "brother", "zh": "哥哥/弟弟", "fact": "哥哥弟弟都是 brother。想说清楚，就说 big brother 或 little brother。", "quiz": {"type": "picture", "options": ["👦", "👧", "👪"]}},
    {"id": "L0-019", "topic": "family", "emoji": "👧", "word": "sister", "zh": "姐姐/妹妹", "fact": "姐姐妹妹都是 sister。姐姐是 big sister，妹妹是 little sister。", "quiz": {"type": "picture", "options": ["👧", "👪", "👫"]}},
    {"id": "L0-020", "topic": "family", "emoji": "👪", "word": "family", "zh": "一家人", "fact": "family 就是一家人：爸爸、妈妈，还有你！", "quiz": {"type": "picture", "options": ["👪", "👫", "👩"]}},
    {"id": "L0-021", "topic": "family", "emoji": "👫", "word": "friend", "zh": "朋友", "fact": "一起玩的好伙伴叫 friend，最好的朋友叫 best friend。", "quiz": {"type": "picture", "options": ["👫", "👩", "👨"]}},
    {"id": "L0-022", "topic": "body", "emoji": "👁️", "word": "eye", "zh": "眼睛", "fact": "一只眼睛是 eye，两只是 eyes。眨眼睛叫 blink。", "quiz": {"type": "picture", "options": ["👁️", "👂", "👃"]}},
    {"id": "L0-023", "topic": "body", "emoji": "👂", "word": "ear", "zh": "耳朵", "fact": "hear（听）里面就藏着 ear（耳朵）！用耳朵来听，太对了。", "quiz": {"type": "picture", "options": ["👂", "👃", "👄"]}},
    {"id": "L0-024", "topic": "body", "emoji": "👃", "word": "nose", "zh": "鼻子", "fact": "nose 和 knows（知道）读音一模一样！", "quiz": {"type": "picture", "options": ["👃", "👄", "🦷"]}},
    {"id": "L0-025", "topic": "body", "emoji": "👄", "word": "mouth", "zh": "嘴巴", "fact": "张大嘴巴说 Ahh，医生最喜欢看你的 mouth 啦。", "quiz": {"type": "picture", "options": ["👄", "🦷", "👅"]}},
    {"id": "L0-026", "topic": "body", "emoji": "🦷", "word": "tooth", "zh": "牙齿", "fact": "一颗牙是 tooth，很多颗是 teeth，可不是 tooths！", "quiz": {"type": "picture", "options": ["🦷", "👅", "💇"]}},
