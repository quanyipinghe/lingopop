    {"id": "L0-035", "topic": "colors", "emoji": "🔴", "word": "red", "zh": "红色", "fact": "红灯 red light 停一停，绿灯 green light 才能走。", "quiz": {"type": "picture", "options": ["🔴", "🧡", "💛"]}},
    {"id": "L0-036", "topic": "colors", "emoji": "🧡", "word": "orange", "zh": "橙色", "fact": "orange 既是橙色，也是橙子！这个颜色就是照着橙子起的名字。", "quiz": {"type": "picture", "options": ["🧡", "💛", "💚"]}},
