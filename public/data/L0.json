    {"id": "L0-028", "topic": "body", "emoji": "💇", "word": "hair", "zh": "头发", "fact": "一个人的头上大约有十万根头发！", "quiz": {"type": "picture", "options": ["💇", "🤚", "🦶"]}},
    {"id": "L0-029", "topic": "body", "emoji": "🤚", "word": "hand", "zh": "手", "fact": "拍拍手英语说 clap your hands!", "quiz": {"type": "picture", "options": ["🤚", "🦶", "🦵"]}},
    {"id": "L0-030", "topic": "body", "emoji": "🦶", "word": "foot", "zh": "脚", "fact": "一只脚 foot，两只脚 feet，和 tooth 变 teeth 一个样。", "quiz": {"type": "picture", "options": ["🦶", "🦵", "💪"]}},
