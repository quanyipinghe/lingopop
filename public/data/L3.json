    {"id": "s01", "topic": "stories", "emoji": "📞", "word": "telephone", "zh": "电话", "fact": "tele = 远，phone = 声音。telephone 就是“远方的声音”，television 就是“远方的画面”。", "quiz": {"type": "choice", "q": "telescope 里的 tele 是什么意思？", "options": ["远", "电", "小"]}},
    {"id": "s02", "topic": "stories", "emoji": "🚲", "word": "bicycle", "zh": "自行车", "fact": "bi = 二，cycle = 轮。所以 bicycle 是两个轮子，tricycle 是三个轮子。", "quiz": {"type": "choice", "q": "tricycle 有几个轮子？", "options": ["3 个", "2 个", "4 个"]}},
    {"id": "s10", "topic": "stories", "emoji": "💯", "word": "century", "zh": "世纪", "fact": "cent = 一百。century 是一百年，centimeter 是一米的百分之一，percent 是“每一百”。", "quiz": {"type": "choice", "q": "a century 是多少年？", "options": ["100 年", "1000 年", "10 年"]}},
    {"id": "s11", "topic": "stories", "emoji": "📅", "word": "December", "zh": "十二月", "fact": "decem 在拉丁语里是“十”。古罗马的历法从三月开始，December 原本是第十个月！", "quiz": {"type": "choice", "q": "October 里的 octo 是什么意思？", "options": ["八", "十", "六"]}},
    {"id": "s12", "topic": "stories", "emoji": "🥐", "word": "breakfast", "zh": "早餐", "fact": "break = 打破，fast = 禁食。睡了一整夜没吃东西，早餐就是“打破禁食”的那一顿。", "quiz": {"type": "spell"}},
    {"id": "s14", "topic": "stories", "emoji": "🎧", "word": "audio", "zh": "音频", "fact": "aud = 听。audio 是声音，audience 是听众，audition 是“听一听你唱得怎么样”的试音。", "quiz": {"type": "choice", "q": "audience 是什么人？", "options": ["听众", "演员", "作者"]}},
    {"id": "s15", "topic": "stories", "emoji": "👀", "word": "vision", "zh": "视力", "fact": "vis = 看。vision 是视力，visible 是看得见的，visit 是“去看看”。", "quiz": {"type": "choice", "q": "invisible 是什么意思？", "options": ["看不见的", "听不见的", "摸不着的"]}},
    {"id": "s16", "topic": "stories", "emoji": "👋", "word": "goodbye", "zh": "再见", "fact": "goodbye 是 God be with ye（愿上帝与你同在）一路缩出来的。", "quiz": {"type": "choice", "q": "goodbye 最初是哪句话的缩写？", "options": ["God be with ye", "Good boy", "Go buy"]}},
    {"id": "s20", "topic": "stories", "emoji": "🔁", "word": "recycle", "zh": "回收利用", "fact": "re = 再一次，cycle = 循环。recycle 就是“再循环一次”。", "quiz": {"type": "spell"}},
    {"id": "L3-001", "topic": "stories", "emoji": "😱", "word": "nightmare", "zh": "噩梦", "fact": "nightmare 里的 mare 不是母马，而是古代传说里压在睡觉的人胸口的小妖怪。", "quiz": {"type": "choice", "q": "nightmare 里的 mare 原来指什么？", "options": ["压在人胸口的小妖怪", "母马", "大海"]}},
    {"id": "L3-002", "topic": "stories", "emoji": "💪", "word": "muscle", "zh": "肌肉", "fact": "muscle 来自拉丁语“小老鼠”，古人觉得肌肉动起来，像皮肤下有只小老鼠在跑。", "quiz": {"type": "choice", "q": "muscle 最早的意思是？", "options": ["小老鼠", "大力士", "骨头"]}},
    {"id": "L3-003", "topic": "stories", "emoji": "🌪️", "word": "disaster", "zh": "灾难", "fact": "dis（坏）+ aster（星星）：古人觉得灾难是星星的位置不好带来的。", "quiz": {"type": "choice", "q": "disaster 里的 aster 是什么意思？", "options": ["星星", "灾难", "天空"]}},
