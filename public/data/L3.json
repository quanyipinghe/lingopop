    {"id": "L3-011", "topic": "stories", "emoji": "❄️", "word": "January", "zh": "一月", "fact": "January 来自罗马的门神 Janus，他有两张脸，一张看过去，一张看未来，正适合一年的开头。", "quiz": {"type": "choice", "q": "门神 Janus 为什么适合一月？", "options": ["一张脸看过去，一张脸看未来", "他很怕冷", "他喜欢开门"]}},
    {"id": "L3-012", "topic": "stories", "emoji": "🧶", "word": "clue", "zh": "线索", "fact": "clue 原来写作 clew，意思是“线团”。希腊神话里，英雄靠一团线走出了迷宫。", "quiz": {"type": "choice", "q": "clue 最早的意思是？", "options": ["线团", "钥匙", "脚印"]}},
    {"id": "L3-013", "topic": "grammar", "emoji": "🚶", "word": "went", "zh": "去了（go 的过去式）", "fact": "go 的过去式不是 goed，而是 went。", "quiz": {"type": "choice", "q": "Yesterday I ___ to the park.", "options": ["went", "goed", "go"]}},
    {"id": "L3-014", "topic": "grammar", "emoji": "🍽️", "word": "ate", "zh": "吃了（eat 的过去式）", "fact": "eat 的过去式是 ate，读音和 eight（八）一样！", "quiz": {"type": "choice", "q": "Last night I ___ noodles.", "options": ["ate", "eated", "eat"]}},
    {"id": "L3-015", "topic": "grammar", "emoji": "🦒", "word": "taller than", "zh": "比……高", "fact": "比较用 -er：tall → taller，再加上 than：I'm taller than you.", "quiz": {"type": "choice", "q": "“长颈鹿比大象高”怎么说？", "options": ["The giraffe is taller than the elephant.", "The giraffe is more tall than the elephant.", "The giraffe is taller as the elephant."]}},
    {"id": "L3-016", "topic": "grammar", "emoji": "🏆", "word": "best", "zh": "最好的", "fact": "good → better → best，变化得很特别。", "quiz": {"type": "choice", "q": "good 的“最……”形式是？", "options": ["best", "goodest", "most good"]}},
    {"id": "L3-017", "topic": "grammar", "emoji": "🍏", "word": "an apple", "zh": "一个苹果", "fact": "元音开头的词前面用 an：an apple、an egg。hour 的 h 不发音，所以是 an hour。", "quiz": {"type": "choice", "q": "下面哪个对？", "options": ["an hour", "a hour", "an house"]}},
