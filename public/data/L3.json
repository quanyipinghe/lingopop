    {"id": "L3-019", "topic": "grammar", "emoji": "📅", "word": "on Monday", "zh": "在星期一", "fact": "星期前面用 on：on Monday；月份用 in：in May；钟点用 at：at 7 o'clock。", "quiz": {"type": "choice", "q": "“在七点”怎么说？", "options": ["at 7 o'clock", "on 7 o'clock", "in 7 o'clock"]}},
