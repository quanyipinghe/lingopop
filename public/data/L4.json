    {"id": "a15", "topic": "shop", "emoji": "💸", "word": "pricey", "zh": "有点贵", "fact": "想委婉地说“有点贵”，用 It's a bit pricey，比 too expensive 听起来柔和。", "quiz": {"type": "choice", "q": "It's a bit pricey 是什么意思？", "options": ["有点贵", "有点便宜", "有点难看"]}},
    {"id": "L4-001", "topic": "shop", "emoji": "💰", "word": "How much is it?", "zh": "多少钱？", "fact": "问一件东西的价钱说 How much is it?，问好几件就说 How much are they?", "quiz": {"type": "choice", "q": "问“这双鞋多少钱？”", "options": ["How much are these shoes?", "How many are these shoes?", "How much is these shoes?"]}},
    {"id": "L4-002", "topic": "shop", "emoji": "👗", "word": "Can I try it on?", "zh": "我能试穿吗？", "fact": "想试穿就说 Can I try it on?，试衣间叫 fitting room。", "quiz": {"type": "choice", "q": "试衣间英语叫？", "options": ["fitting room", "trying room", "dress room"]}},
    {"id": "L4-003", "topic": "shop", "emoji": "📏", "word": "Do you have it in a smaller size?", "zh": "有小一号的吗？", "fact": "想换小一号就说 a smaller size，大一号就说 a bigger size。", "quiz": {"type": "choice", "q": "想要大一号，怎么说？", "options": ["Do you have it in a bigger size?", "Do you have it more big?", "Give me big size."]}},
    {"id": "L4-004", "topic": "shop", "emoji": "🛍️", "word": "I'll take it.", "zh": "我要了。", "fact": "决定买了，就说 I'll take it.", "quiz": {"type": "choice", "q": "在商店里说 I'll take it，意思是？", "options": ["我买了", "我不付钱拿走", "我拿去看看"]}},
    {"id": "L4-005", "topic": "shop", "emoji": "🧾", "word": "receipt", "zh": "收据", "fact": "receipt 里的 p 不发音，读作“瑞西特”。", "quiz": {"type": "listen", "options": ["receipt", "recipe", "receive"]}},
    {"id": "L4-006", "topic": "shop", "emoji": "🏷️", "word": "50% off", "zh": "打五折", "fact": "标签上写 50% off 是打五折。on sale 在美国常常也是“打折”。", "quiz": {"type": "choice", "q": "商店门口写着 50% off 是？", "options": ["打五折", "涨价一半", "只剩一半商品"]}},
    {"id": "L4-007", "topic": "shop", "emoji": "💳", "word": "Cash or card?", "zh": "现金还是刷卡？", "fact": "结账时店员会问 Cash or card?", "quiz": {"type": "listen", "options": ["Cash or card?", "Cash or car?", "Catch a card?"]}},
    {"id": "L4-008", "topic": "directions", "emoji": "🚉", "word": "How do I get to the station?", "zh": "去车站怎么走？", "fact": "问怎么去某个地方，就说 How do I get to...?", "quiz": {"type": "choice", "q": "问“去博物馆怎么走？”", "options": ["How do I get to the museum?", "How can I arrive the museum?", "Where to go museum?"]}},
    {"id": "L4-009", "topic": "directions", "emoji": "🏦", "word": "It's opposite the bank.", "zh": "在银行对面。", "fact": "opposite 是“对面”，next to 是“紧挨着”，between 是“在两者之间”。", "quiz": {"type": "choice", "q": "“在银行对面”怎么说？", "options": ["opposite the bank", "next to the bank", "between the bank"]}},
    {"id": "L4-010", "topic": "directions", "emoji": "🏞️", "word": "Go past the park.", "zh": "经过公园。", "fact": "go past 是“经过”：Go past the park and turn right.", "quiz": {"type": "choice", "q": "Go past the park 是什么意思？", "options": ["经过公园", "公园已经过去了", "去公园散步"]}},
    {"id": "L4-011", "topic": "directions", "emoji": "🚶", "word": "It's a ten-minute walk.", "zh": "走路十分钟。", "fact": "It's a ten-minute walk 是“走路要十分钟”。注意 minute 这里不加 s。", "quiz": {"type": "choice", "q": "哪句对？", "options": ["It's a ten-minute walk.", "It's a ten-minutes walk.", "It's ten minute walk."]}},
    {"id": "L4-012", "topic": "directions", "emoji": "🚦", "word": "traffic lights", "zh": "红绿灯", "fact": "红绿灯叫 traffic lights。十字路口在英国叫 crossroads，在美国常说 intersection。", "quiz": {"type": "choice", "q": "红绿灯英语叫？", "options": ["traffic lights", "red green lights", "road lamps"]}},
    {"id": "L4-013", "topic": "directions", "emoji": "😟", "word": "I'm lost.", "zh": "我迷路了。", "fact": "迷路了就说 I'm lost.，然后请别人帮忙：Can you help me?", "quiz": {"type": "listen", "options": ["I'm lost.", "I'm last.", "I'm loud."]}},
    {"id": "L4-014", "topic": "order", "emoji": "📋", "word": "Are you ready to order?", "zh": "可以点菜了吗？", "fact": "menu 是菜单，点菜叫 order。服务员会问 Are you ready to order?", "quiz": {"type": "choice", "q": "服务员问 Are you ready to order?，意思是？", "options": ["可以点菜了吗？", "准备好付钱了吗？", "您要预订吗？"]}},
    {"id": "L4-015", "topic": "order", "emoji": "🍗", "word": "I'd like the chicken, please.", "zh": "我要鸡肉。", "fact": "点菜说 I'd like... please，比 I want... 礼貌得多。", "quiz": {"type": "choice", "q": "哪种点餐方式最有礼貌？", "options": ["I'd like the soup, please.", "Give me soup.", "I want soup now."]}},
    {"id": "L4-016", "topic": "order", "emoji": "🥡", "word": "For here or to go?", "zh": "在这儿吃还是带走？", "fact": "美国快餐店会问 For here or to go?，英国常说 Eat in or take away?", "quiz": {"type": "choice", "q": "For here or to go? 问的是？", "options": ["在这儿吃还是带走", "来这儿还是去那儿", "现在还是以后"]}},
    {"id": "L4-017", "topic": "order", "emoji": "😋", "word": "delicious", "zh": "美味的", "fact": "好吃除了 delicious，还可以说 yummy 或 tasty。", "quiz": {"type": "spell"}},
    {"id": "L4-018", "topic": "order", "emoji": "🥕", "word": "vegetarian", "zh": "素食者", "fact": "不吃肉的人叫 vegetarian，连鸡蛋、牛奶也不吃的人叫 vegan。", "quiz": {"type": "choice", "q": "vegetarian 不吃什么？", "options": ["肉", "蔬菜", "米饭"]}},
    {"id": "L4-019", "topic": "order", "emoji": "🍨", "word": "dessert", "zh": "甜点", "fact": "甜点 dessert 有两个 s，沙漠 desert 只有一个。记法：甜点想吃两份！", "quiz": {"type": "choice", "q": "“甜点”怎么拼？", "options": ["dessert", "desert", "deserrt"]}},
    {"id": "L4-020", "topic": "weekend", "emoji": "🗓️", "word": "What are you doing this weekend?", "zh": "你周末干什么？", "fact": "问周末计划，常用现在进行时：What are you doing this weekend?", "quiz": {"type": "choice", "q": "最自然的回答是？", "options": ["I'm going to the beach.", "I go beach yesterday.", "I am weekend."]}},
    {"id": "L4-021", "topic": "weekend", "emoji": "🎉", "word": "Would you like to come?", "zh": "你想一起来吗？", "fact": "邀请别人用 Would you like to...?，答应就说 I'd love to!", "quiz": {"type": "choice", "q": "朋友邀请你，你很想去，回答？", "options": ["I'd love to!", "I'd like to love!", "Yes, I would like!"]}},
    {"id": "L4-022", "topic": "weekend", "emoji": "🙁", "word": "I'm afraid I can't.", "zh": "恐怕我去不了。", "fact": "拒绝邀请说 I'm afraid I can't.，这里的 afraid 不是害怕，是“恐怕”。", "quiz": {"type": "choice", "q": "I'm afraid I can't come 是什么意思？", "options": ["恐怕我来不了", "我害怕过来", "我不敢来"]}},
    {"id": "L4-023", "topic": "weekend", "emoji": "🍿", "word": "What's on at the cinema?", "zh": "电影院在放什么？", "fact": "What's on? 是“在上演什么”。", "quiz": {"type": "choice", "q": "What's on at the cinema? 问的是？", "options": ["电影院在放什么", "电影院楼上是什么", "电影院开门了吗"]}},
    {"id": "L4-024", "topic": "weekend", "emoji": "🎟️", "word": "return ticket", "zh": "往返票", "fact": "英国说 single（单程）和 return（往返），美国说 one-way 和 round-trip。", "quiz": {"type": "choice", "q": "往返票美国人叫？", "options": ["round-trip ticket", "return-back ticket", "two-way ticket"]}},
    {"id": "L4-025", "topic": "weekend", "emoji": "⏰", "word": "Let's meet at six.", "zh": "我们六点见。", "fact": "约时间说 Let's meet at six.，到时候见就说 See you then!", "quiz": {"type": "listen", "options": ["Let's meet at six.", "Let's eat at six.", "Let's meet at seven."]}},
    {"id": "L4-026", "topic": "tricky", "emoji": "🤝", "word": "borrow", "zh": "借（进来）", "fact": "borrow 是借进来，lend 是借出去：Can I borrow your pen? = Can you lend me your pen?", "quiz": {"type": "choice", "q": "“我能借你的书吗？”", "options": ["Can I borrow your book?", "Can I lend your book?", "Can you borrow me your book?"]}},
    {"id": "L4-027", "topic": "tricky", "emoji": "🤡", "word": "funny", "zh": "好笑的", "fact": "funny 是“好笑的”，fun 是“好玩的”。说派对很好玩要用 fun。", "quiz": {"type": "choice", "q": "“这个游戏很好玩”是？", "options": ["The game is fun.", "The game is funny.", "The game is funning."]}},
    {"id": "L4-028", "topic": "tricky", "emoji": "😑", "word": "bored", "zh": "觉得无聊的", "fact": "人觉得无聊用 bored，事情让人无聊用 boring：I'm bored. The film is boring.", "quiz": {"type": "choice", "q": "“我好无聊”是？", "options": ["I'm bored.", "I'm boring.", "I'm bore."]}},
    {"id": "L4-029", "topic": "tricky", "emoji": "🤔", "word": "interested in", "zh": "对……感兴趣", "fact": "对某事感兴趣：I'm interested in music.，后面跟 in。", "quiz": {"type": "choice", "q": "哪句对？", "options": ["I'm interested in art.", "I'm interesting in art.", "I'm interested at art."]}},
    {"id": "L4-030", "topic": "tricky", "emoji": "💡", "word": "advice", "zh": "建议", "fact": "advice 不可数，不说 an advice，要说 a piece of advice。", "quiz": {"type": "choice", "q": "哪句对？", "options": ["Can you give me some advice?", "Can you give me an advice?", "Can you give me advices?"]}},
    {"id": "L4-031", "topic": "tricky", "emoji": "⏳", "word": "since", "zh": "自从", "fact": "since 后面跟起点：since 2020；for 后面跟一段时间：for three years。", "quiz": {"type": "choice", "q": "“我在这儿住了三年”怎么说？", "options": ["I've lived here for three years.", "I've lived here since three years.", "I live here three years ago."]}},
    {"id": "L4-032", "topic": "tricky", "emoji": "✅", "word": "already", "zh": "已经", "fact": "already 是“已经”，常用在肯定句；yet 用在否定句和疑问句：Have you finished yet?", "quiz": {"type": "choice", "q": "“我已经吃过了”怎么说？", "options": ["I've already eaten.", "I've yet eaten.", "I already eat yesterday."]}},
    {"id": "L4-033", "topic": "tricky", "emoji": "🕰️", "word": "used to", "zh": "过去常常", "fact": "used to 表示以前常常这样、现在不了：I used to live in Shanghai.", "quiz": {"type": "choice", "q": "I used to play the piano 是什么意思？", "options": ["我以前常弹钢琴", "我习惯弹钢琴", "我在用钢琴"]}},
    {"id": "L4-034", "topic": "phone", "emoji": "📞", "word": "Can I speak to Tom, please?", "zh": "请找一下汤姆。", "fact": "打电话找人说 Can I speak to..., please?，接电话的人会说 Hold on, please.", "quiz": {"type": "choice", "q": "电话里说 Hold on, please，意思是？", "options": ["请稍等", "请抓紧", "请挂断"]}},
    {"id": "L4-035", "topic": "phone", "emoji": "✉️", "word": "Best wishes", "zh": "祝好", "fact": "写信开头用 Dear...，结尾常用 Best wishes；写给很亲近的人可以用 Love。", "quiz": {"type": "choice", "q": "给老师写邮件，结尾最合适的是？", "options": ["Best wishes, Lily", "Dear, Lily", "Hello, Lily"]}}
  ]
